XTerm.vt100.translations: #override \
  Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
  Ctrl Shift <Key>V: insert-selection(CLIPBOARD)
 
! --- Font Settings ---
XTerm*faceName: Monospace
XTerm*faceSize: 12
XTerm*utf8: 2
! --- Window Size ---
XTerm*VT100*geometry: 90x11
! --- Cursor Settings ---
XTerm*cursorUnderLine: true
XTerm*cursorBlink: true
 
 
 
! --- Amber Night XTerm Theme ---
XTerm*background: #000000
XTerm*foreground: #F5DCC3
XTerm*cursorColor: #FF9F43
XTerm*pointerColor: #FFB454
 
! Normal colors
XTerm*color0:  #211A14
XTerm*color1:  #E06C45
XTerm*color2:  #A3B86C
XTerm*color3:  #D79943
XTerm*color4:  #B58B68
XTerm*color5:  #C08497
XTerm*color6:  #78A89B
XTerm*color7:  #DCCBB8
 
! Bright colors
XTerm*color8:  #756454
XTerm*color9:  #FF8057
XTerm*color10: #BDD68A
XTerm*color11: #FFB454
XTerm*color12: #D6A77A
XTerm*color13: #E6A4B4
XTerm*color14: #A4D0C1
XTerm*color15: #FFF0DB
 
 
! --- Enable Copy Paste with Mouse ---
XTerm*selectToClipboard: true
 
! --- Bell ---
XTerm*bellIsUrgent: true
XTerm*visualBell: false
XTerm*eightBitInput: false
XTerm*metaSendsEscape: true
XTerm*locale: true
XTerm.vt100.internalBorder: 30
XTerm*scrollBar: false
