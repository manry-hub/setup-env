{
    "workbench.colorTheme": "One Dark Pro Darker",
    "oneDarkPro.bold": true,
    "workbench.colorCustomizations": {
        "editor.selectionBackground": "#c6d0d33f",
        "editor.background": "#000000",
        "statusBar.background": "#000000",
        "statusBar.border": "#343434",
        "tab.inactiveBackground": "#000000",
        "tab.border": "#494949",
        "sideBarTitle.background": "#000000",
        "activityBar.background": "#000000",
        "sideBar.background": "#000000",
        "panel.background": "#000000",
        "terminal.background": "#000000",
        "statusBarItem.remoteBackground": "#585857",
        "titleBar.activeBackground": "#000000",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#393939",
        "tab.activeBorderTop": "#ffffff",
        "editorHoverWidget.background": "#010101ba",
        "editorHoverWidget.border": "#5e5d5dd0",
        "editorSuggestWidget.background": "#040404",
        "tree.indentGuidesStroke": "#666666",
        "editor.lineHighlightBackground": "#1073cf2d",
        "editor.lineHighlightBorder": "#9fced11f",
    },
    "workbench.tree.indent": 20,
    "workbench.startupEditor": "none",
    "workbench.tree.renderIndentGuides": "always",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.settings.applyToAllProfiles": ["workbench.startupEditor", "codesnap.transparentBackground"],
    "workbench.editor.enablePreview": true,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.wrapTabs": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.reduceMotion": "on",
    "window.newWindowDimensions": "fullscreen",
    "window.title": "${activeFolderMedium}${separator}${remoteName}${separator}${activeRepositoryBranchName}",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.fontSize": 13,
    "chat.editor.fontSize": 13,
    "editor.fontSize": 12.5,
    "editor.lineHeight": 20,
    "editor.fontFamily": "Fira Code",
    "editor.codeLensFontFamily": "Fira Code, monospace",
    "editor.letterSpacing": 0.3,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "expand",
    "editor.linkedEditing": true,
    "editor.autoIndent": "full",
    "editor.guides.bracketPairs": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "on",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "off",
    "editor.quickSuggestions": {
        "strings": "on",
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": false,
    "editor.renderLineHighlight": "gutter",
    "editor.smoothScrolling": false,
    "editor.minimap.size": "fit",
    "editor.minimap.autohide": "mouseover",
    "editor.minimap.sectionHeaderFontSize": 19,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 15000,
    "files.associations": {
        "*.css": "tailwindcss",
    },
    "security.workspace.trust.enabled": false,
    "search.showLineNumbers": true,
    "codesnap.transparentBackground": true,
    "extensions.autoUpdate": "off",
    "extensions.autoCheckUpdates": false,
    "tailwindCSS.includeLanguages": {
        "plaintext": "html",
    },
    "path-intellisense.showHiddenFiles": true,
    "npm-intellisense.packageSubfoldersIntellisense": true,
    "redhat.telemetry.enabled": false,
    "javascript.suggest.autoImports": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.tabWidth": 4,
    "prettier.printWidth": 150,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.completeFunctionParens": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.callArgumentNames": "all",
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.indexing": true,
    "python.analysis.packageIndexDepths": [
        {
            "name": "numpy",
            "depth": 2,
        },
        {
            "name": "pandas",
            "depth": 2,
        },
    ],
    "[prisma]": {
        "editor.defaultFormatter": "Prisma.prisma",
    },
    "[blade]": {
        "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    },
    "[php]": {
        "editor.defaultFormatter": "kokororin.vscode-phpfmt",
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["storage.type.annotation.java", "meta.declaration.annotation.java"],
                "settings": {
                    "foreground": "#ffffff",
                },
            },
            {
                "scope": ["entity.name.type.interface", "entity.other.inherited-class"],
                "settings": {
                    "foreground": "#98C379",
                },
            },
        ],
    },
    "chat.commandCenter.enabled": false,
    "search.exclude": {
        "**/node_modules": false,
    },
    "search.followSymlinks": false,
    "search.quickOpen.includeSymbols": true,
    "workbench.panel.showLabels": false,
    "terminal.integrated.inheritEnv": false,
    "window.zoomLevel": 1,
    "window.menuBarVisibility": "compact",
    "workbench.secondarySideBar.showLabels": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.editorAssociations": {
        "*.dat": "default",
    },
    "explorer.confirmDragAndDrop": false,
    "window.commandCenter": false,
    "editor.inlayHints.enabled": "off",
    "diffEditor.wordWrap": "off",
    "editor.guides.indentation": false,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.bracketPairColorization.enabled": true,
    "extensions.ignoreRecommendations": true,
    "window.newWindowProfile": "Default",
    "window.customTitleBarVisibility": "windowed",
    "workbench.browser.openLocalhostLinks": true,
    "workbench.externalBrowser": "chrome",
    "codesnap.showWindowTitle": true,
    "remote.portsAttributes": {
        "8080": {
            "protocol": "https",
        },
    },
    "editor.inlineSuggest.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "php": false,
    },
    "git.confirmSync": false,
    "js/ts.experimental.useTsgo": true,
    "chatgpt.reviewDelivery": "detached",
    "chatgpt.followUpQueueMode": "queue",
    "terminal.integrated.commandsToSkipShell": ["kilo-code.new.agentManagerOpen", "kilo-code.new.agentManager.showTerminal"],
    "php.codeActions.enabled": false,
    "editor.codeLens": false,
    "php.problems.exclude": {
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/bootstrap/cache/**": true,
    },
    "chat.viewSessions.orientation": "stacked",
    "markdown-preview-enhanced.enablePreviewZenMode": true,
    "markdown-preview-enhanced.codeBlockTheme": "auto.css",
    "markdown-preview-enhanced.previewTheme": "github-light.css",
    "workbench.iconTheme": "bearded-icons",
}
